# =====================================================
# CREATEBYMOH — Performance configuration (Apache)
# Browser caching + text compression for faster loads
# =====================================================

# --- Long-lived browser cache for heavy static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType video/mp4                 "access plus 30 days"
  ExpiresByType audio/mpeg                "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# --- Explicit Cache-Control headers (covers hosts without mod_expires) ---
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|svg|mp4|webm|mp3|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Videos are served with byte-range streaming
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges "bytes"
  </FilesMatch>
</IfModule>

# --- Gzip text responses (HTML/CSS/JS shrink ~70-80%) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Keep-Alive: reuse connections for the many thumb requests ---
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
KeepAlive On
